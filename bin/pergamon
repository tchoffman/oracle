#!/usr/bin/env bash
# The pergamon CLI. Thin dispatcher over the Python RAG modules + kiwix-serve.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VENV_PY="$REPO_ROOT/build/venv/bin/python"

usage() {
  cat <<EOF
pergamon — your offline knowledge library

Usage:
  pergamon setup               Interactively pick what to install
  pergamon ask "question"      Ask the library (RAG over your corpus)
  pergamon search "query"      Semantic search — top-K raw hits, no LLM
  pergamon plan "goal"         Structured plan (steps, resources, risks)
  pergamon serve [--port N]    Serve ZIMs via kiwix-serve (default port 8080)
  pergamon web [--port N]      Launch the web UI (default port 8090)
  pergamon mesh mock           Mesh-radio mock mode (stdin → chunked answer)
  pergamon mesh listen         Listen for Meshtastic DMs over USB
  pergamon ledger ...          Record-keeping: list / show / add / rm / query
  pergamon services ...        LAN services: list / up / down / restart / status / logs
  pergamon identity ...        Nostr keys: list / create / use / show / export / import
  pergamon nostr ...           Sign + publish events (post, relays)
  pergamon status              Show what's installed / indexed / ready
  pergamon shell               Drop into a REPL with the venv activated

Build the pergamon first:
  make setup   (optional — choose what to install)
  make all     (or re-run after setup to download selections)

See README.md for details.
EOF
}

require_venv() {
  if [[ ! -x "$VENV_PY" ]]; then
    echo "Error: Python venv not built. Run 'make venv' (or 'make all') first." >&2
    exit 1
  fi
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  setup)
    require_venv
    cd "$REPO_ROOT"
    exec "$VENV_PY" -m rag.setup "$@"
    ;;

  ask)
    if [[ $# -eq 0 ]]; then
      echo "Usage: pergamon ask \"your question here\"" >&2
      exit 2
    fi
    require_venv
    cd "$REPO_ROOT"
    "$VENV_PY" -m rag.query "$@"
    ;;

  search)
    if [[ $# -eq 0 ]]; then
      echo "Usage: pergamon search \"your query\" [--k N]" >&2
      exit 2
    fi
    require_venv
    cd "$REPO_ROOT"
    "$VENV_PY" -m rag.search "$@"
    ;;

  plan)
    if [[ $# -eq 0 ]]; then
      echo "Usage: pergamon plan \"your goal\"" >&2
      exit 2
    fi
    require_venv
    cd "$REPO_ROOT"
    "$VENV_PY" -m rag.plan "$@"
    ;;

  serve)
    port=8080
    use_app=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --port) port="$2"; shift 2 ;;
        --app)  use_app=1; shift ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
      esac
    done
    zim_dir="$REPO_ROOT/build/corpus/zims"
    zims=("$zim_dir"/*.zim)
    if [[ ! -e "${zims[0]}" ]]; then
      echo "No ZIMs under $zim_dir. Run 'make corpus' first." >&2
      exit 1
    fi

    # Preferred: scriptable kiwix-serve binary. Falls back to Kiwix.app (GUI).
    kiwix="$REPO_ROOT/build/bin/kiwix-serve"
    if [[ "$use_app" == "0" && -x "$kiwix" ]]; then
      echo "Serving ${#zims[@]} ZIM(s) at http://localhost:$port"
      exec "$kiwix" --port "$port" "${zims[@]}"
    elif [[ "$use_app" == "0" ]] && command -v kiwix-serve >/dev/null 2>&1; then
      echo "Serving ${#zims[@]} ZIM(s) at http://localhost:$port"
      exec kiwix-serve --port "$port" "${zims[@]}"
    elif [[ -d /Applications/Kiwix.app ]]; then
      echo "kiwix-serve binary not available — opening Kiwix.app with your ZIMs."
      echo "To get the scriptable headless server, see docs/runbook.md."
      open -a /Applications/Kiwix.app "${zims[@]}"
    else
      echo "Error: no kiwix-serve binary AND no Kiwix.app installed. Run 'make deps'." >&2
      exit 1
    fi
    ;;

  web)
    port=8090
    host=0.0.0.0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --port) port="$2"; shift 2 ;;
        --host) host="$2"; shift 2 ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
      esac
    done
    require_venv
    cd "$REPO_ROOT"
    echo "Pergamon web UI → http://localhost:$port"
    exec "$VENV_PY" -m uvicorn rag.web:app --host "$host" --port "$port"
    ;;

  mesh)
    sub="${1:-}"
    shift || true
    require_venv
    cd "$REPO_ROOT"
    case "$sub" in
      mock)   exec "$VENV_PY" -m modules.comms.meshtastic.mock "$@" ;;
      listen) exec "$VENV_PY" -m modules.comms.meshtastic.listen "$@" ;;
      *)
        echo "Usage: pergamon mesh {mock|listen}" >&2
        exit 2
        ;;
    esac
    ;;

  ledger)
    require_venv
    cd "$REPO_ROOT"
    exec "$VENV_PY" -m rag.ledger "$@"
    ;;

  services)
    cd "$REPO_ROOT"
    exec scripts/services.sh "$@"
    ;;

  identity)
    require_venv
    cd "$REPO_ROOT"
    exec "$VENV_PY" -m rag.identity "$@"
    ;;

  nostr)
    require_venv
    cd "$REPO_ROOT"
    exec "$VENV_PY" -m rag.nostr "$@"
    ;;

  status)
    require_venv
    cd "$REPO_ROOT"
    "$VENV_PY" -m rag.status
    ;;

  shell)
    require_venv
    cd "$REPO_ROOT"
    exec "$VENV_PY"
    ;;

  help|-h|--help|"")
    usage
    ;;

  *)
    echo "unknown command: $cmd" >&2
    usage
    exit 2
    ;;
esac
