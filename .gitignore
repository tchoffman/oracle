# The pergamon's local build artifacts — never committed, always reproducible.
# Includes: build/corpus, build/chroma, build/models, build/services,
# build/venv, build/bin, and build/identity (private keys!).
build/

# Per-install user customization (output of `pergamon setup`).
config/install.local.yaml

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Env
.env
.env.local
